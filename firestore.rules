rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: students
    // Fields:
    //   - name: string (required)
    //   - class: string (required)
    //   - photoUrl: string (required, base64)
    //
    // Collection: attendance
    // Fields:
    //   - studentId: string (required)
    //   - studentName: string (required)
    //   - date: string (required, YYYY-MM-DD)
    //   - timestamp: timestamp (required)
    //   - status: string (required, enum: ['active', 'reset'])
    //   - isLate: bool (optional)
    //
    // Collection: settings
    // Fields:
    //   - lateThreshold: string (HH:mm)
    //
    // ===============================================================

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        ((exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "lexuanky646@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidStudent(data) {
      return data.keys().hasAll(['name', 'class', 'photoUrl']) &&
             data.name is string && data.name.size() > 0 && data.name.size() < 100 &&
             data.class is string && data.class.size() > 0 && data.class.size() < 20 &&
             data.photoUrl is string && data.photoUrl.size() > 0;
    }

    function isValidAttendance(data) {
      return data.keys().hasAll(['studentId', 'studentName', 'studentClass', 'date', 'timestamp', 'status']) &&
             data.studentId is string &&
             data.studentName is string && data.studentName.size() > 0 &&
             data.studentClass is string && data.studentClass.size() > 0 &&
             data.date is string && data.date.matches("^\\d{4}-\\d{2}-\\d{2}$") &&
             data.timestamp is timestamp &&
             data.status in ['active', 'reset'] &&
             (!('isLate' in data) || data.isLate is bool);
    }

    function isValidSettings(data) {
      return !('lateThreshold' in data) || (data.lateThreshold is string && data.lateThreshold.matches("^\\d{2}:\\d{2}$"));
    }

    // ===============================================================
    // Rules
    // ===============================================================

    match /students/{studentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() && isValidStudent(request.resource.data);
      allow delete: if isAdmin();
    }

    match /attendance/{attendanceId} {
      allow read: if true;
      allow create: if isAuthenticated() && isValidAttendance(request.resource.data);
      allow update: if isAdmin() && isValidAttendance(request.resource.data);
      allow delete: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin() && isValidSettings(request.resource.data);
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }
    
    match /test/connection {
      allow read: if true;
    }
  }
}
